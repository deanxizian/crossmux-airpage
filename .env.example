# 基础设置
TZ=Asia/Shanghai
OUTPUT_DIR=/data
AIRPAGE_WIDTH=528
AIRPAGE_HEIGHT=792

# 天气（示例：上海）
WEATHER_LOCATION=上海
WEATHER_LATITUDE=31.2304
WEATHER_LONGITUDE=121.4737
WEATHER_TIMEZONE=Asia/Shanghai
WEATHER_FORECAST_DAYS=5
WEATHER_REFRESH_SECONDS=1800
WEATHER_MAX_AGE_SECONDS=21600

# A 股大盘 + 两只自选股，使用 Yahoo 格式：沪市 .SS、深市 .SZ
MARKET_INDEX_SYMBOL=000001.SS
MARKET_INDEX_LABEL=
STOCK_SYMBOLS=601727.SS,600021.SS
# 名称留空时按代码匹配内置名称；未知代码直接显示代码。逗号空位会保留。
STOCK_LABELS=
STOCK_RANGE=5d
STOCK_INTERVAL=30m
STOCK_REFRESH_SECONDS=60
STOCK_MAX_AGE_SECONDS=900

# 新闻（私有新浪快讯兼容 API；完整地址只写入本地 .env）
# 栏目：all；0=A股，1=宏观，2=公司，3=数据，4=市场，5=国际，6=观点，7=央行，8=其他
NEWS_API_BASE_URL=
NEWS_CATEGORY=all
NEWS_LABEL=新浪 · 快讯
NEWS_ITEMS=4
NEWS_REFRESH_SECONDS=120
NEWS_MAX_AGE_SECONDS=1800

# 从 CrossMux AirPage 二维码复制完整链接。设备 ID 等同凭据，不要提交到 Git。
AIRPAGE_DEVICE_URL=
AIRPAGE_TRUSTED_HOSTS=airpage.crossmux.cn,airpage.crossmux.com,airpage.yunhug.com
AIRPAGE_ENABLED=true
AIRPAGE_PUSH_INTERVAL_MINUTES=1
AIRPAGE_PUSH_ON_START=true

REQUEST_TIMEOUT_SECONDS=20
# 整轮采集和上传的总耗时限制，不同于 HTTP 连接/读写阶段超时。
COLLECTION_TIMEOUT_SECONDS=25
PUSH_TIMEOUT_SECONDS=20
